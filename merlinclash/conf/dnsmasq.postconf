#!/bin/sh
# Preserve DHCP/user hooks and scoped VPN DNS; manage only the marked DNS block.
. /jffs/softcenter/scripts/base.sh || exit 1
. /jffs/softcenter/scripts/clash_safe.sh || exit 1
exec 9>&-
CONFIG=${1:-}
INDEX=${2:-0}
ETC_DIR=/etc
TEMP_ETC_DIR=/tmp/etc
WORK=
CANDIDATE=
SERVER_STAGE=
SERVER_KEEP=0
case "$INDEX" in ''|*[!0-9]*) exit 1 ;; esac
[ "${#INDEX}" -le 4 ] || exit 1
[ -f "$CONFIG" ] || exit 1
base=${CONFIG##*/}
SERVER_PREFIX=/tmp/mc-dnsmasq-server-files.$base.
case "$base" in dnsmasq*.conf|dnsmasq.conf[0-9]*) ;; *) exit 1 ;; esac
case "$base" in *[!A-Za-z0-9_.-]*) exit 1 ;; esac
input_dir=$(readlink -f "$(dirname "$CONFIG")") || exit 1
etc_dir=$(readlink -f "$ETC_DIR") || exit 1
temp_etc_dir=$(readlink -f "$TEMP_ETC_DIR")
[ "$input_dir" = "$etc_dir" ] || [ "$input_dir" = "$temp_etc_dir" ] || exit 1
CONFIG=$(readlink -f "$CONFIG") || exit 1
config_dir=$(dirname "$CONFIG")
[ "$config_dir" = "$etc_dir" ] || [ "$config_dir" = "$temp_etc_dir" ] || exit 1

# Firmware invokes this callback during controller-owned DNS restart, so it
# must use its own configuration lock rather than re-enter the lifecycle lock.
exec 7>"/tmp/merlinclash-dnsmasq-$base.lock" || exit 1
flock -n 7 || exit 75
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    [ -z "$CANDIDATE" ] || rm -f "$CANDIDATE"
    [ "$SERVER_KEEP" = 1 ] || [ -z "$SERVER_STAGE" ] || rm -rf "$SERVER_STAGE"
    [ -z "$WORK" ] || rm -rf "$WORK"
    exit "$status"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
WORK=$(mc_mktemp -d /tmp/mc-dnsmasq.XXXXXX) || exit 1
CANDIDATE=$(mc_mktemp "$config_dir/.$base.merlinclash.XXXXXX") || exit 1
cp -p "$CONFIG" "$CANDIDATE" || exit 1
awk '
    $0=="# BEGIN Magic Catling 2 DNS server files" {block=1; next}
    $0=="# END Magic Catling 2 DNS server files" {block=0; next}
    block && /^servers-file=/ {sub(/^servers-file=/, ""); print}
' "$CONFIG" > "$WORK/old-server-files" || exit 1

# Undo only this hook's former changes. An incomplete ownership marker is a
# validation failure, not permission to discard the remaining user config.
awk '
    $0=="# BEGIN Magic Catling 2 DNS" {if(block || dns++) bad=1; block=1; next}
    $0=="# END Magic Catling 2 DNS" {if(block!=1) bad=1; block=0; next}
    $0=="# BEGIN Magic Catling 2 DNS server files" {if(block || files++) bad=1; block=2; next}
    $0=="# END Magic Catling 2 DNS server files" {if(block!=2) bad=1; block=0; next}
    block {next}
    index($0,"# MC2 DNS suspended: ")==1 {print substr($0,22); next}
    {print}
    END {if(block || bad) exit 1}
' "$CONFIG" > "$WORK/original" || exit 1

active=0
if [ "$(dbus get merlinclash_enable)" = 1 ] && [ "$(dbus get merlinclash_ipt_closeproxy_sw)" != 1 ]; then
    pids=$(mc_core_pids)
    if [ -n "$pids" ] && { [ "$base" = dnsmasq.conf ] || [ "$(dbus get merlinclash_ipt_proxyiot_sw)" = 1 ]; }; then
        cfg=$(mc_active_config) || exit 1
        [ -f "$cfg" ] || exit 1
        dns_enabled=$(yq e -r '.dns.enable // false' "$cfg" 2>/dev/null) || exit 1
        case "$dns_enabled" in
        false) ;;  # A disabled core DNS leaves firmware/user upstreams intact.
        true)
        listen=$(yq e -r '.dns.listen // ""' "$cfg" 2>/dev/null) || exit 1
        port=${listen##*:}
        case "$port" in ''|*[!0-9]*) exit 1 ;; esac
        [ "$port" -gt 0 ] && [ "$port" -le 65535 ] || exit 1
        host=${listen%:*}
        case "$host" in '['*']') host=${host#\[}; host=${host%\]} ;; esac
        case "$host" in ''|0.0.0.0|localhost) host=127.0.0.1 ;; ::) host=::1 ;; esac
        case "$host" in ''|*[!0-9a-fA-F:.]*) exit 1 ;; esac
        netstat -lnup 2>/dev/null | awk -v pids="$pids" -v port="$port" '
            BEGIN {n=split(pids,p,/[^0-9]+/); for(i=1;i<=n;i++) valid[p[i]]=1}
            /^udp/ && $4 ~ ":" port "$" {split($NF,owner,"/"); if(valid[owner[1]]) found=1}
            END {exit !found}
        ' || exit 1
        active=1
        ;;
        *) exit 1 ;;
        esac
    fi
fi

if [ "$active" = 1 ]; then
    # dnsmasq initially races /#/ against global servers, including a WAN
    # servers-file. Preserve domain-scoped entries and suspend only globals.
    cat > "$WORK/filter.awk" <<'AWK'
    function scoped(value, a,n,i,domains,kept,global) {
        if(value !~ /^\//) {changed=1; return ""}
        n=split(value,a,"/"); domains="/"; kept=0; global=0
        for(i=2;i<n;i++) {
            if(a[i]=="#" || a[i]==".") global=1
            else {domains=domains a[i] "/"; kept++}
        }
        if(!global) return "unchanged"
        changed=1
        return kept ? "server=" domains a[n] : ""
    }
    /^[[:space:]]*servers-file[[:space:]]*=/ && mode=="main" {
        print "# MC2 DNS suspended: " $0; next
    }
    /^[[:space:]]*server[[:space:]]*=/ {
        value=$0; sub(/^[^=]*=[[:space:]]*/, "", value)
        sub(/[[:space:]]+$/, "", value); changed=0; result=scoped(value)
        if(changed) {
            if(mode=="main") {
                print "# MC2 DNS suspended: " $0
                if(result!="") print result >> retained
            } else if(result!="") print result
            next
        }
    }
    {print}
AWK
    [ "$?" = 0 ] || exit 1
    : > "$WORK/scoped-inline" || exit 1
    : > "$WORK/new-server-files" || exit 1
    # dnsmasq permits double-quoted filenames and comments outside those
    # quotes. Decode the pointer only; its original line remains reversible.
    awk '
        /^[[:space:]]*servers-file[[:space:]]*=/ {
            sub(/^[^=]*=[[:space:]]*/, ""); value=""; quoted=0; finish=0
            for(i=1;i<=length($0);i++) {
                c=substr($0,i,1)
                if(c=="\"") {quoted=!quoted; continue}
                if(c=="\\" && quoted) {
                    c=substr($0,++i,1)
                    if(c=="") exit 1
                    if(c=="n" || c=="r") exit 1
                    if(c=="t") c="\t"
                    else if(c=="b") c=sprintf("%c",8)
                    else if(c=="e") c=sprintf("%c",27)
                    else if(c!="\\" && c!="\"") c="\\" c
                } else if(c=="#" && !quoted &&
                          (i==1 || substr($0,i-1,1) ~ /[[:space:]]/)) break
                value=value c
                if(quoted || c !~ /[[:space:]]/) finish=length(value)
            }
            if(quoted) exit 1
            value=substr(value,1,finish)
            if(value=="") exit 1
            print value
        }
    ' "$WORK/original" > "$WORK/server-files" || exit 1
    n=0
    while IFS= read -r file; do
        [ -r "$file" ] || exit 1
        [ -n "$SERVER_STAGE" ] || SERVER_STAGE=$(mc_mktemp -d "${SERVER_PREFIX}XXXXXX") || exit 1
        printf '%s\n' "$base" > "$SERVER_STAGE/owned" || exit 1
        awk -v mode=external -f "$WORK/filter.awk" "$file" > "$SERVER_STAGE/$n.conf" || exit 1
        chmod 644 "$SERVER_STAGE/$n.conf" || exit 1
        printf '%s\n' "$SERVER_STAGE/$n.conf" >> "$WORK/new-server-files" || exit 1
        n=$((n+1))
    done < "$WORK/server-files"
    [ -z "$SERVER_STAGE" ] || chmod 755 "$SERVER_STAGE" || exit 1
    # Reuse a byte-identical readable generation on repeated On callbacks.
    reuse=0
    if [ "$n" -gt 0 ] && [ "$(wc -l < "$WORK/old-server-files")" -eq "$n" ]; then
        reuse=1; i=0
        while IFS= read -r old; do
            directory=$(dirname "$old")
            mc_dns_server_dir_owned "$directory" "$base" &&
                [ -f "$old" ] && [ ! -L "$old" ] &&
                cmp -s "$SERVER_STAGE/$i.conf" "$old" || reuse=0
            i=$((i+1))
        done < "$WORK/old-server-files"
        [ "$reuse" != 1 ] || cp "$WORK/old-server-files" "$WORK/new-server-files" || exit 1
    fi
    awk -v mode=main -v retained="$WORK/scoped-inline" -f "$WORK/filter.awk" "$WORK/original" > "$CANDIDATE" || exit 1
    if [ -s "$WORK/new-server-files" ] || [ -s "$WORK/scoped-inline" ]; then
        printf '# BEGIN Magic Catling 2 DNS server files\n' >> "$CANDIDATE" || exit 1
        cat "$WORK/scoped-inline" >> "$CANDIDATE" || exit 1
        while IFS= read -r file; do printf 'servers-file=%s\n' "$file"; done < "$WORK/new-server-files" >> "$CANDIDATE" || exit 1
        printf '# END Magic Catling 2 DNS server files\n' >> "$CANDIDATE" || exit 1
    fi
    printf '# BEGIN Magic Catling 2 DNS\nno-resolv\nserver=/#/%s#%s\n# END Magic Catling 2 DNS\n' "$host" "$port" >> "$CANDIDATE" || exit 1
else
    cat "$WORK/original" > "$CANDIDATE" || exit 1
fi

# Parse the complete resulting configuration, including retained user hooks.
dnsmasq --test --conf-file="$CANDIDATE" >/dev/null 2>&1 || exit 1
cmp -s "$CANDIDATE" "$CONFIG" && exit 0
mv -f "$CANDIDATE" "$CONFIG" || exit 1
CANDIDATE=
[ -z "$SERVER_STAGE" ] || [ "${reuse:-0}" = 1 ] || SERVER_KEEP=1
# Old generations remain readable until the checked controller observes the
# replacement DNS owner. mc_dnsmasq_wait then retires unreferenced generations.
